# Anthropic Claude API key (OPTIONAL — the app runs fully in free mock-AI
# mode without this; only needed if you want to enable real Claude API calls
# by setting USE_MOCK_AI = False in ai_coach.py)
ANTHROPIC_API_KEY=

# Flask session secret key (used to sign session cookies for the coach chat
# feature). Use any random string in production; a default is provided for
# local development if this is left blank.
SECRET_KEY=

# Database connection string. Leave blank for local development — the app
# automatically falls back to a local SQLite database. In production
# (e.g. Render), this is set to the PostgreSQL connection string provided
# by your hosting platform.
DATABASE_URL=